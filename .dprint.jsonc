{
  "typescript": {
  },
  "json": {
    "jsonTrailingCommaFiles": [
      "dprint.jsonc",
      "tsconfig.json",
      ".vscode/settings.json",
    ],
  },
  "sortPackageJson": {
  },
  "markdown": {
  },
  "toml": {
  },
  "malva": {
  },
  "markup": {
  },
  "yaml": {
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "pnpm-lock.yaml",
    "**/routeTree.gen.ts",
    // Imported WPT fixtures preserve exact CSS/markup, including invalid syntax
    // and nonvisual stylesheets bound to SHA-256 hashes.
    "examples/wpt-css/tests/**",
  ],
  "plugins": [
    "npm:dprint-plugin-sort-package-json@0.2.1",
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.23.3",
    "npm:@dprint/toml@0.8.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.3",
    "npm:dprint-plugin-yaml@0.6.0",
  ],
}
