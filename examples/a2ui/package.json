{
  "name": "@lynx-example/a2ui",
  "version": "0.3.0",
  "description": "An example shows how to use a2ui in Lynx",
  "author": "Lynx Authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynx-family/lynx-examples.git",
    "directory": "examples/a2ui"
  },
  "files": [
    "dist/",
    "src/",
    "rsbuild.config.ts",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run catalog && rsbuild build",
    "catalog": "genui a2ui generate catalog --source src/catalog --out-dir src --catalog-id https://lynxjs.org/lynx-examples/a2ui/catalog.json",
    "dev": "rsbuild dev",
    "preview": "rsbuild preview"
  },
  "dependencies": {
    "@lynx-js/genui": "0.8.1",
    "@lynx-js/luna-styles": "0.2.2",
    "@lynx-js/lynx-ui": "3.142.0",
    "@lynx-js/react": "0.129.4"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@lynx-js/config-rsbuild-plugin": "0.3.0",
    "@lynx-js/qrcode-rsbuild-plugin": "catalog:",
    "@lynx-js/react-rsbuild-plugin": "0.22.4",
    "@lynx-js/rsbuild-plugin": "0.2.0",
    "@lynx-js/types": "catalog:",
    "@rsbuild/core": "2.3.3",
    "@types/react": "^18.3.28",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
