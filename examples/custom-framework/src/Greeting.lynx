screen Greeting {
  state title = "Hello World"

  view #content {
    text #title {
      value = title
      on tap {
        run refreshGreeting
      }
    }
  }

  task refreshGreeting {
    title <- await fetchGreeting()
  }

  style #content {
    width: 100%
    height: 100%
    display: linear
    linear-gravity: center
    linear-cross-gravity: center
    background-color: #f5f7ff
  }

  style #title {
    padding: 1.5rem 2rem
    color: #ffffff
    font-size: 2rem
    font-weight: 700
    text-align: center
    background-color: #4f46e5
    border-radius: 1rem
  }
}
